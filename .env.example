# StockSense environment variables (copy to .env for docker compose)

# --- Market data ---
# Providers are tried in order. Yahoo Finance needs no key.
MARKET_PROVIDERS=yahoo,twelvedata,simulated
# Free key: https://twelvedata.com/
TWELVE_DATA_API_KEY=

# --- Database (docker compose creates MySQL with these) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=stocksense
MYSQL_USER=stocksense
MYSQL_PASSWORD=change-me

# --- Optional ---
# PORT=8081
# ML_SERVICE_URL=http://localhost:8000
