<?xml version="1.0" encoding="UTF-8"?>
<!--
  StockSense message contract (document/literal wrapped).
  Every request element is validated against this schema by the SOAP endpoint.
  Optional children may be omitted; element order is not significant (xsd:all).
-->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:tf="urn:stocksense:ws"
            targetNamespace="urn:stocksense:ws"
            elementFormDefault="qualified">

    <!-- ===================== simple types ===================== -->
    <xsd:simpleType name="SymbolType">
        <xsd:restriction base="xsd:token">
            <xsd:pattern value="[A-Za-z0-9][A-Za-z0-9.\-^=]{0,14}"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="QueryType">
        <xsd:restriction base="xsd:token">
            <xsd:minLength value="1"/>
            <xsd:maxLength value="50"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="RangeType">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="1W"/>
            <xsd:enumeration value="1M"/>
            <xsd:enumeration value="3M"/>
            <xsd:enumeration value="6M"/>
            <xsd:enumeration value="1Y"/>
            <xsd:enumeration value="3Y"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="IntervalType">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="DAILY"/>
            <xsd:enumeration value="WEEKLY"/>
            <xsd:enumeration value="MONTHLY"/>
            <xsd:enumeration value="YEARLY"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="HorizonType">
        <xsd:annotation>
            <xsd:documentation>Prediction horizon in trading days.</xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="xsd:int">
            <xsd:enumeration value="1"/>
            <xsd:enumeration value="5"/>
            <xsd:enumeration value="10"/>
            <xsd:enumeration value="30"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="OwnerType">
        <xsd:restriction base="xsd:token">
            <xsd:pattern value="[A-Za-z0-9_\-]{8,64}"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="LimitType">
        <xsd:restriction base="xsd:int">
            <xsd:minInclusive value="1"/>
            <xsd:maxInclusive value="200"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- ===================== requests ===================== -->
    <xsd:element name="searchStocks">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="query" type="tf:QueryType"/>
                <xsd:element name="limit" type="tf:LimitType" minOccurs="0"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="getCompanyInfo">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="symbol" type="tf:SymbolType"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="getStockQuote">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="symbol" type="tf:SymbolType"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="getHistoricalData">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="symbol" type="tf:SymbolType"/>
                <xsd:element name="range" type="tf:RangeType" minOccurs="0"/>
                <xsd:element name="interval" type="tf:IntervalType" minOccurs="0"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="getTechnicalAnalysis">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="symbol" type="tf:SymbolType"/>
                <xsd:element name="range" type="tf:RangeType" minOccurs="0"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="predictStock">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="symbol" type="tf:SymbolType"/>
                <xsd:element name="horizonDays" type="tf:HorizonType" minOccurs="0"/>
                <xsd:element name="forceRetrain" type="xsd:boolean" minOccurs="0"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="compareStocks">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="symbols">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="symbol" type="tf:SymbolType" minOccurs="2" maxOccurs="5"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
                <xsd:element name="range" type="tf:RangeType" minOccurs="0"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="getPredictionHistory">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="symbol" type="tf:SymbolType" minOccurs="0"/>
                <xsd:element name="limit" type="tf:LimitType" minOccurs="0"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="getModelPerformance">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="symbol" type="tf:SymbolType" minOccurs="0"/>
                <xsd:element name="horizonDays" type="tf:HorizonType" minOccurs="0"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="getWatchlist">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="owner" type="tf:OwnerType"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="addToWatchlist">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="owner" type="tf:OwnerType"/>
                <xsd:element name="symbol" type="tf:SymbolType"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="removeFromWatchlist">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="owner" type="tf:OwnerType"/>
                <xsd:element name="symbol" type="tf:SymbolType"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="getSystemStatus">
        <xsd:complexType/>
    </xsd:element>

    <!-- ===================== shared types ===================== -->
    <xsd:complexType name="StockHitType">
        <xsd:all>
            <xsd:element name="symbol" type="xsd:string"/>
            <xsd:element name="name" type="xsd:string"/>
            <xsd:element name="exchange" type="xsd:string" minOccurs="0"/>
            <xsd:element name="type" type="xsd:string" minOccurs="0"/>
        </xsd:all>
    </xsd:complexType>

    <xsd:complexType name="QuoteType">
        <xsd:all>
            <xsd:element name="symbol" type="xsd:string"/>
            <xsd:element name="name" type="xsd:string"/>
            <xsd:element name="price" type="xsd:decimal"/>
            <xsd:element name="change" type="xsd:decimal"/>
            <xsd:element name="changePercent" type="xsd:decimal"/>
            <xsd:element name="open" type="xsd:decimal"/>
            <xsd:element name="high" type="xsd:decimal"/>
            <xsd:element name="low" type="xsd:decimal"/>
            <xsd:element name="previousClose" type="xsd:decimal"/>
            <xsd:element name="volume" type="xsd:long"/>
            <xsd:element name="currency" type="xsd:string" minOccurs="0"/>
            <xsd:element name="exchange" type="xsd:string" minOccurs="0"/>
            <xsd:element name="source" type="xsd:string"/>
            <xsd:element name="asOf" type="xsd:dateTime"/>
        </xsd:all>
    </xsd:complexType>

    <xsd:complexType name="BarType">
        <xsd:all>
            <xsd:element name="date" type="xsd:date"/>
            <xsd:element name="open" type="xsd:decimal"/>
            <xsd:element name="high" type="xsd:decimal"/>
            <xsd:element name="low" type="xsd:decimal"/>
            <xsd:element name="close" type="xsd:decimal"/>
            <xsd:element name="volume" type="xsd:long"/>
        </xsd:all>
    </xsd:complexType>

    <xsd:complexType name="HistorySummaryType">
        <xsd:all>
            <xsd:element name="startDate" type="xsd:date"/>
            <xsd:element name="endDate" type="xsd:date"/>
            <xsd:element name="startPrice" type="xsd:decimal"/>
            <xsd:element name="endPrice" type="xsd:decimal"/>
            <xsd:element name="changePercent" type="xsd:decimal"/>
            <xsd:element name="high" type="xsd:decimal"/>
            <xsd:element name="low" type="xsd:decimal"/>
            <xsd:element name="averageVolume" type="xsd:decimal"/>
            <xsd:element name="annualizedVolatility" type="xsd:decimal"/>
            <xsd:element name="maxDrawdownPercent" type="xsd:decimal"/>
            <xsd:element name="bestDayPercent" type="xsd:decimal"/>
            <xsd:element name="worstDayPercent" type="xsd:decimal"/>
            <xsd:element name="upDays" type="xsd:int"/>
            <xsd:element name="downDays" type="xsd:int"/>
        </xsd:all>
    </xsd:complexType>

    <xsd:complexType name="SignalType">
        <xsd:all>
            <xsd:element name="indicator" type="xsd:string"/>
            <xsd:element name="value" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="signal" type="xsd:string"/>
            <xsd:element name="note" type="xsd:string"/>
        </xsd:all>
    </xsd:complexType>

    <xsd:complexType name="TechnicalPointType">
        <xsd:all>
            <xsd:element name="date" type="xsd:date"/>
            <xsd:element name="close" type="xsd:decimal"/>
            <xsd:element name="sma20" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="sma50" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="ema20" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="rsi14" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="macd" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="macdSignal" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="macdHistogram" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="bbUpper" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="bbMiddle" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="bbLower" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="atr14" type="xsd:decimal" minOccurs="0"/>
        </xsd:all>
    </xsd:complexType>

    <xsd:complexType name="ModelScoreType">
        <xsd:all>
            <xsd:element name="name" type="xsd:string"/>
            <xsd:element name="accuracy" type="xsd:decimal"/>
            <xsd:element name="precision" type="xsd:decimal"/>
            <xsd:element name="recall" type="xsd:decimal"/>
            <xsd:element name="f1" type="xsd:decimal"/>
            <xsd:element name="rocAuc" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="selected" type="xsd:boolean"/>
        </xsd:all>
    </xsd:complexType>

    <xsd:complexType name="DriverType">
        <xsd:all>
            <xsd:element name="name" type="xsd:string"/>
            <xsd:element name="importance" type="xsd:decimal"/>
        </xsd:all>
    </xsd:complexType>

    <xsd:complexType name="PredictionType">
        <xsd:all>
            <xsd:element name="id" type="xsd:long"/>
            <xsd:element name="symbol" type="xsd:string"/>
            <xsd:element name="horizonDays" type="xsd:int"/>
            <xsd:element name="direction" type="xsd:string"/>
            <xsd:element name="probabilityUp" type="xsd:decimal"/>
            <xsd:element name="probabilityDown" type="xsd:decimal"/>
            <xsd:element name="confidence" type="xsd:decimal"/>
            <xsd:element name="model" type="xsd:string"/>
            <xsd:element name="modelVersion" type="xsd:string"/>
            <xsd:element name="baseDate" type="xsd:date"/>
            <xsd:element name="basePrice" type="xsd:decimal"/>
            <xsd:element name="targetDate" type="xsd:date"/>
            <xsd:element name="createdAt" type="xsd:dateTime"/>
            <xsd:element name="status" type="xsd:string"/>
            <xsd:element name="reliability" type="xsd:string" minOccurs="0"/>
            <xsd:element name="trainSamples" type="xsd:int" minOccurs="0"/>
            <xsd:element name="testSamples" type="xsd:int" minOccurs="0"/>
            <xsd:element name="baselineAccuracy" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="actualClose" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="actualDirection" type="xsd:string" minOccurs="0"/>
            <xsd:element name="correct" type="xsd:boolean" minOccurs="0"/>
            <xsd:element name="evaluatedAt" type="xsd:dateTime" minOccurs="0"/>
            <xsd:element name="cached" type="xsd:boolean" minOccurs="0"/>
            <xsd:element name="models" minOccurs="0">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="model" type="tf:ModelScoreType" minOccurs="0" maxOccurs="unbounded"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="drivers" minOccurs="0">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="driver" type="tf:DriverType" minOccurs="0" maxOccurs="unbounded"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="disclaimer" type="xsd:string" minOccurs="0"/>
        </xsd:all>
    </xsd:complexType>

    <xsd:complexType name="TallyType">
        <xsd:all>
            <xsd:element name="total" type="xsd:long"/>
            <xsd:element name="evaluated" type="xsd:long"/>
            <xsd:element name="correct" type="xsd:long"/>
            <xsd:element name="hitRatePercent" type="xsd:decimal"/>
        </xsd:all>
    </xsd:complexType>

    <xsd:complexType name="MetricType">
        <xsd:all>
            <xsd:element name="symbol" type="xsd:string"/>
            <xsd:element name="horizonDays" type="xsd:int"/>
            <xsd:element name="model" type="xsd:string"/>
            <xsd:element name="version" type="xsd:string"/>
            <xsd:element name="accuracy" type="xsd:decimal"/>
            <xsd:element name="precision" type="xsd:decimal"/>
            <xsd:element name="recall" type="xsd:decimal"/>
            <xsd:element name="f1" type="xsd:decimal"/>
            <xsd:element name="rocAuc" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="trainSamples" type="xsd:int" minOccurs="0"/>
            <xsd:element name="testSamples" type="xsd:int" minOccurs="0"/>
            <xsd:element name="baselineAccuracy" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="selected" type="xsd:boolean"/>
            <xsd:element name="trainedAt" type="xsd:dateTime"/>
        </xsd:all>
    </xsd:complexType>

    <xsd:complexType name="ComparePointType">
        <xsd:all>
            <xsd:element name="date" type="xsd:date"/>
            <xsd:element name="value" type="xsd:decimal"/>
        </xsd:all>
    </xsd:complexType>

    <xsd:complexType name="CompareItemType">
        <xsd:all>
            <xsd:element name="symbol" type="xsd:string"/>
            <xsd:element name="name" type="xsd:string"/>
            <xsd:element name="price" type="xsd:decimal"/>
            <xsd:element name="periodReturnPercent" type="xsd:decimal"/>
            <xsd:element name="annualizedVolatility" type="xsd:decimal"/>
            <xsd:element name="maxDrawdownPercent" type="xsd:decimal"/>
            <xsd:element name="rsi14" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="overall" type="xsd:string"/>
            <xsd:element name="series">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="point" type="tf:ComparePointType" minOccurs="0" maxOccurs="unbounded"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </xsd:all>
    </xsd:complexType>

    <xsd:complexType name="WatchItemType">
        <xsd:all>
            <xsd:element name="symbol" type="xsd:string"/>
            <xsd:element name="name" type="xsd:string"/>
            <xsd:element name="price" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="change" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="changePercent" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="currency" type="xsd:string" minOccurs="0"/>
            <xsd:element name="source" type="xsd:string" minOccurs="0"/>
            <xsd:element name="addedAt" type="xsd:dateTime"/>
        </xsd:all>
    </xsd:complexType>

    <!-- ===================== responses ===================== -->
    <xsd:element name="searchStocksResponse">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="count" type="xsd:int"/>
                <xsd:element name="stocks">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="stock" type="tf:StockHitType" minOccurs="0" maxOccurs="unbounded"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="getCompanyInfoResponse">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="symbol" type="xsd:string"/>
                <xsd:element name="name" type="xsd:string"/>
                <xsd:element name="sector" type="xsd:string" minOccurs="0"/>
                <xsd:element name="industry" type="xsd:string" minOccurs="0"/>
                <xsd:element name="exchange" type="xsd:string" minOccurs="0"/>
                <xsd:element name="currency" type="xsd:string" minOccurs="0"/>
                <xsd:element name="country" type="xsd:string" minOccurs="0"/>
                <xsd:element name="website" type="xsd:string" minOccurs="0"/>
                <xsd:element name="description" type="xsd:string" minOccurs="0"/>
                <xsd:element name="marketCap" type="xsd:decimal" minOccurs="0"/>
                <xsd:element name="peRatio" type="xsd:decimal" minOccurs="0"/>
                <xsd:element name="eps" type="xsd:decimal" minOccurs="0"/>
                <xsd:element name="dividendYield" type="xsd:decimal" minOccurs="0">
                    <xsd:annotation>
                        <xsd:documentation>Percent, e.g. 0.55 means 0.55%.</xsd:documentation>
                    </xsd:annotation>
                </xsd:element>
                <xsd:element name="beta" type="xsd:decimal" minOccurs="0"/>
                <xsd:element name="week52High" type="xsd:decimal" minOccurs="0"/>
                <xsd:element name="week52Low" type="xsd:decimal" minOccurs="0"/>
                <xsd:element name="roe" type="xsd:decimal" minOccurs="0">
                    <xsd:annotation>
                        <xsd:documentation>Return on equity, percent.</xsd:documentation>
                    </xsd:annotation>
                </xsd:element>
                <xsd:element name="roce" type="xsd:decimal" minOccurs="0">
                    <xsd:annotation>
                        <xsd:documentation>Return on capital employed = EBIT / (total assets - current liabilities), percent.</xsd:documentation>
                    </xsd:annotation>
                </xsd:element>
                <xsd:element name="source" type="xsd:string"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="getStockQuoteResponse">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="quote" type="tf:QuoteType"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="getHistoricalDataResponse">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="symbol" type="xsd:string"/>
                <xsd:element name="range" type="xsd:string"/>
                <xsd:element name="interval" type="xsd:string"/>
                <xsd:element name="source" type="xsd:string"/>
                <xsd:element name="count" type="xsd:int"/>
                <xsd:element name="bars">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="bar" type="tf:BarType" minOccurs="0" maxOccurs="unbounded"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
                <xsd:element name="summary" type="tf:HistorySummaryType"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="getTechnicalAnalysisResponse">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="symbol" type="xsd:string"/>
                <xsd:element name="asOf" type="xsd:date"/>
                <xsd:element name="price" type="xsd:decimal"/>
                <xsd:element name="overall" type="xsd:string"/>
                <xsd:element name="buySignals" type="xsd:int"/>
                <xsd:element name="sellSignals" type="xsd:int"/>
                <xsd:element name="neutralSignals" type="xsd:int"/>
                <xsd:element name="signals">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="signal" type="tf:SignalType" minOccurs="0" maxOccurs="unbounded"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
                <xsd:element name="series">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="point" type="tf:TechnicalPointType" minOccurs="0" maxOccurs="unbounded"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="compareStocksResponse">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="range" type="xsd:string"/>
                <xsd:element name="items">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="item" type="tf:CompareItemType" minOccurs="0" maxOccurs="unbounded"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="predictStockResponse">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="prediction" type="tf:PredictionType"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="getPredictionHistoryResponse">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="count" type="xsd:int"/>
                <xsd:element name="summary" type="tf:TallyType"/>
                <xsd:element name="predictions">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="prediction" type="tf:PredictionType" minOccurs="0" maxOccurs="unbounded"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="getModelPerformanceResponse">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="metrics">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="metric" type="tf:MetricType" minOccurs="0" maxOccurs="unbounded"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
                <xsd:element name="livePerformance" type="tf:TallyType"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="getWatchlistResponse">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="count" type="xsd:int"/>
                <xsd:element name="items">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="item" type="tf:WatchItemType" minOccurs="0" maxOccurs="unbounded"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="addToWatchlistResponse">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="symbol" type="xsd:string"/>
                <xsd:element name="added" type="xsd:boolean"/>
                <xsd:element name="count" type="xsd:long"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="removeFromWatchlistResponse">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="symbol" type="xsd:string"/>
                <xsd:element name="removed" type="xsd:boolean"/>
                <xsd:element name="count" type="xsd:long"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="getSystemStatusResponse">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="status" type="xsd:string"/>
                <xsd:element name="serverTime" type="xsd:dateTime"/>
                <xsd:element name="database" type="xsd:string"/>
                <xsd:element name="providers">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="provider" minOccurs="0" maxOccurs="unbounded">
                                <xsd:complexType>
                                    <xsd:all>
                                        <xsd:element name="name" type="xsd:string"/>
                                        <xsd:element name="available" type="xsd:boolean"/>
                                    </xsd:all>
                                </xsd:complexType>
                            </xsd:element>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
                <xsd:element name="mlService">
                    <xsd:complexType>
                        <xsd:all>
                            <xsd:element name="status" type="xsd:string"/>
                            <xsd:element name="detail" type="xsd:string" minOccurs="0"/>
                        </xsd:all>
                    </xsd:complexType>
                </xsd:element>
                <xsd:element name="version" type="xsd:string"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>

    <!-- ===================== fault detail ===================== -->
    <xsd:element name="error">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="code" type="xsd:string"/>
                <xsd:element name="message" type="xsd:string"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>
</xsd:schema>
