            <wsdl:fault name="StockSenseFault"><soap:fault name="StockSenseFault" use="literal"/></wsdl:fault>
        </wsdl:operation>
        <wsdl:operation name="removeFromWatchlist">
            <soap:operation soapAction="urn:stocksense:ws/removeFromWatchlist"/>
            <wsdl:input><soap:body use="literal"/></wsdl:input><wsdl:output><soap:body use="literal"/></wsdl:output>
            <wsdl:fault name="StockSenseFault"><soap:fault name="StockSenseFault" use="literal"/></wsdl:fault>
        </wsdl:operation>
        <wsdl:operation name="getSystemStatus">
            <soap:operation soapAction="urn:stocksense:ws/getSystemStatus"/>
