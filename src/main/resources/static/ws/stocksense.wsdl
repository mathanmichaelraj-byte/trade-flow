            <wsdl:input><soap:body use="literal"/></wsdl:input><wsdl:output><soap:body use="literal"/></wsdl:output>
            <wsdl:fault name="StockSenseFault"><soap:fault name="StockSenseFault" use="literal"/></wsdl:fault>
        </wsdl:operation>
        <wsdl:operation name="predictStock">
            <soap:operation soapAction="urn:stocksense:ws/predictStock"/>
            <wsdl:input><soap:body use="literal"/></wsdl:input><wsdl:output><soap:body use="literal"/></wsdl:output>
            <wsdl:fault name="StockSenseFault"><soap:fault name="StockSenseFault" use="literal"/></wsdl:fault>
        </wsdl:operation>
        <wsdl:operation name="compareStocks">
            <soap:operation soapAction="urn:stocksense:ws/compareStocks"/>
            <wsdl:input><soap:body use="literal"/></wsdl:input><wsdl:output><soap:body use="literal"/></wsdl:output>
            <wsdl:fault name="StockSenseFault"><soap:fault name="StockSenseFault" use="literal"/></wsdl:fault>
        </wsdl:operation>
        <wsdl:operation name="getPredictionHistory">
            <soap:operation soapAction="urn:stocksense:ws/getPredictionHistory"/>
            <wsdl:input><soap:body use="literal"/></wsdl:input><wsdl:output><soap:body use="literal"/></wsdl:output>
            <wsdl:fault name="StockSenseFault"><soap:fault name="StockSenseFault" use="literal"/></wsdl:fault>
        </wsdl:operation>
        <wsdl:operation name="getModelPerformance">
            <soap:operation soapAction="urn:stocksense:ws/getModelPerformance"/>
            <wsdl:input><soap:body use="literal"/></wsdl:input><wsdl:output><soap:body use="literal"/></wsdl:output>
            <wsdl:fault name="StockSenseFault"><soap:fault name="StockSenseFault" use="literal"/></wsdl:fault>
        </wsdl:operation>
        <wsdl:operation name="getWatchlist">
            <soap:operation soapAction="urn:stocksense:ws/getWatchlist"/>
            <wsdl:input><soap:body use="literal"/></wsdl:input><wsdl:output><soap:body use="literal"/></wsdl:output>
            <wsdl:fault name="StockSenseFault"><soap:fault name="StockSenseFault" use="literal"/></wsdl:fault>
        </wsdl:operation>
        <wsdl:operation name="addToWatchlist">
