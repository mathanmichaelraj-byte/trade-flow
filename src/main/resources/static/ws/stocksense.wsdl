            <wsdl:fault name="StockSenseFault"><soap:fault name="StockSenseFault" use="literal"/></wsdl:fault>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:service name="StockSenseService">
        <wsdl:port name="StockSensePort" binding="tf:StockSenseBinding">
            <soap:address location="http://localhost:8081/ws/stocksense"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
